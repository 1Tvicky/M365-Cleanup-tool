# Our OWN dedicated Microsoft Entra app registration for this cleanup tool (see
# docs/azure-ad-app-registration.md). One multi-tenant app, owned by us — never a customer's app
# registration/credentials, and never shared with any other CloudFuze product (e.g. the migration
# tool has its own separate registration). Application-permission, grants this app access to a
# CUSTOMER tenant's Graph data only after that tenant's admin explicitly consents.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_CERT_THUMBPRINT=
MICROSOFT_CLIENT_CERT_PRIVATE_KEY_PATH=
# Only set if using a client secret instead of a certificate (not recommended, see docs)
MICROSOFT_CLIENT_SECRET=
# Multi-tenant authority — accepts sign-in from any organizational directory. Leave as "common"
# unless you have a specific reason to restrict it.
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_LEGACY_REDIRECT_URI=https://localhost:4000/api/v1/auth/callback
# Add Clouds per-cloud-type connect flow (docs/azure-ad-app-registration.md §4a) — same app
# registration/credentials as above, a DIFFERENT registered redirect URI. Must match exactly.
MICROSOFT_REDIRECT_URI=https://localhost:4000/api/auth/m365/callback

# Field-level encryption key for connections.encrypted_refresh_token — base64, must decode to
# exactly 32 bytes. Dev-only; production must fetch this from a KMS at startup instead
# (services/tokenEncryption.ts). Generate a dev value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Separate Azure AD app registration for OPERATOR login via "Office 365" SSO — delegated
# (User.Read only), identifies the CloudFuze staff member signing into this tool. Never reuse
# the tenant-cleanup app's client ID here; keep operator identity and customer-tenant access
# on fully separate app registrations.
OPERATOR_AZURE_CLIENT_ID=
OPERATOR_AZURE_CLIENT_SECRET=
OPERATOR_AZURE_REDIRECT_URI=https://localhost:4000/api/v1/auth/office365/callback
OPERATOR_AZURE_TENANT=common

# Google OAuth client for the "Sign in with Google" operator login button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:4000/api/v1/auth/google/callback

# Comma-separated list of email domains allowed to sign in via SSO (leave blank to allow any
# verified email — not recommended for an internal ops tool). e.g. cloudfuze.com
ALLOWED_LOGIN_EMAIL_DOMAINS=cloudfuze.com

# Postgres
DATABASE_URL=postgres://cleanup:cleanup@localhost:5432/m365_cleanup

# Redis (BullMQ job queue + Graph token/response cache)
REDIS_URL=redis://localhost:6379

# Blob storage for pre-delete export manifests (docs/rollback-safety.md)
BLOB_STORAGE_CONNECTION_STRING=
BLOB_STORAGE_CONTAINER=cleanup-exports
EXPORT_RETENTION_DAYS=90

# Session JWT signing key for CloudFuze operator sessions (not M365 tokens)
SESSION_JWT_SECRET=
SESSION_JWT_ISSUER=m365-cleanup-utility
SESSION_COOKIE_NAME=cf_session
SESSION_COOKIE_DOMAIN=
# Minutes until an issued session JWT expires (LOGIN-SES-004 refresh-while-authenticated policy)
SESSION_TTL_MINUTES=480

# Password policy (LOGIN-EDGE-002/003 boundary tests)
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Brute-force lockout (LOGIN-SEC-005)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password-reset token lifetime (LOGIN-FP-009 expired link)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

PORT=4000
NODE_ENV=development
